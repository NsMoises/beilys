# Configuración del Bot
PREFIX=!
BOT_NAME=MiBotWhatsApp
PORT=3000
LOG_LEVEL=info

# Token para API de envío (genera uno seguro)
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=

# Integración con Web App (Nivel Club / tu app)
# WEBHOOK_URL = URL de tu web + /api/webhooks/whatsapp-bot
# WEBHOOK_TOKEN = mismo valor que API_TOKEN (o uno distinto si prefieres)
WEBHOOK_URL=
WEBHOOK_TOKEN=

# MongoDB (opcional - para persistencia de sesión en Render)
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/
# MONGODB_DB=whatsapp-bot

# Prefijos de comandos
# PREFIX=!
# BOT_NAME=MiBotWhatsApp
# PORT=3000
# LOG_LEVEL=info