# Bot Configuration
PREFIX=!
BOT_NAME=MiBotWhatsApp
PORT=3000
LOG_LEVEL=info

# API Token for authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=tu-token-seguro-aqui

# Webhook Configuration (for Laravel backend integration)
WEBHOOK_URL=https://barberia-nivel-club-shaka.onrender.com/api/webhooks/whatsapp-bot
WEBHOOK_TOKEN=tu-token-seguro-aqui
AUTO_REGISTER_URL=https://barberia-nivel-club-shaka.onrender.com/api/webhooks/whatsapp-bot/register
PHONE_E164=51993807551

# MongoDB Configuration (optional - for session persistence and message queuing)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB=whatsapp-bot

# Media Settings
MEDIA_STORAGE_PATH=./media_storage
MEDIA_EXPIRY_MS=3600000
MAX_FILE_SIZE=104857600

# Tunnel Configuration
TUNNEL_ENABLED=true

# Render Deployment
RENDER_DEPLOY_HOOK_URL=
